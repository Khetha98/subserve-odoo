<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_company_form_inherit_compliance" model="ir.ui.view">
        <field name="name">res.company.form.inherit.subserve</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
        <xpath expr="//page[@name='general_info']/group" position="inside">
            <group string="Compliance">
                <field name="cipc_registration_no"/>
                <field name="vat_number"/>
                <field name="compliance_document_ready"/>
            </group>
        </xpath>


        </field>
    </record>

</odoo>
