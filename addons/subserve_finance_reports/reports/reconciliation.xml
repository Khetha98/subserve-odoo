<odoo>
    <record id="reconciliation_pdf" model="ir.actions.report">
        <field name="name">Reconciliation</field>
        <field name="model">subserve.reconciliation.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">subserve_finance_reports.reconciliation_report</field>
        <field name="report_file">subserve_finance_reports.reconciliation_report</field>
        <field name="binding_model_id" ref="model_subserve_reconciliation_wizard"/>
        <field name="binding_type">report</field>
    </record>

<template id="reconciliation_report"> <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Reconciliation Summary</h2> <p>Date: <span t-field="doc.date_to"/></p>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Reference</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.get_unreconciled()" t-as="line">
                                <tr>
                                    <td><t t-esc="line.date"/></td>
                                    <td><t t-esc="line.move_id.name"/></td>
                                    <td class="text-end">
                                        <t t-esc="line.balance" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </t>
</template>
</odoo>