<odoo>
    <record id="balance_sheet_pdf" model="ir.actions.report">
        <field name="name">Balance Sheet</field>
        <field name="model">subserve.balance.sheet.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">subserve_finance_reports.balance_sheet_report</field>
        <field name="report_file">subserve_finance_reports.balance_sheet_report</field>
        <field name="binding_model_id" ref="model_subserve_balance_sheet_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <template id="balance_sheet_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="data" t-value="doc.get_report_data()"/>
                        <h2>Balance Sheet</h2>
                        <p>Date: <span t-field="doc.date_to"/></p>
                    <table class="table table-sm">
                    <tbody>

                        <!-- ASSETS HEADER -->
                        <tr class="table-secondary">
                        <td colspan="2"><strong>Assets</strong></td>
                        </tr>

                        <!-- CURRENT ASSETS -->
                        <tr>
                        <td colspan="2"><strong>Current Assets</strong></td>
                        </tr>

                        <t t-foreach="data.get('assets', {}).get('current', [])" t-as="line">
                        <tr>
                            <td><t t-esc="line['account']"/></td>
                            <td class="text-end">
                            <t t-esc="line['balance']"
                                t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                            </td>
                        </tr>
                        </t>

                        <!-- NON-CURRENT ASSETS -->
                        <tr>
                        <td colspan="2"><strong>Non-Current Assets</strong></td>
                        </tr>

                        <t t-foreach="data['assets']['non_current']" t-as="line">
                        <tr>
                            <td><t t-esc="line['account']"/></td>
                            <td class="text-end">
                            <t t-esc="line['balance']"
                                t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                            </td>
                        </tr>
                        </t>

                        <!-- TOTAL ASSETS -->
                        <tr class="table-light">
                        <td><strong>Total Assets</strong></td>
                        <td class="text-end">
                            <strong>
                            <t t-esc="data['assets']['total']"
                                t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                            </strong>
                        </td>
                        </tr>
                        <!-- LIABILITIES HEADER -->
                        <tr class="table-secondary">
                        <td colspan="2"><strong>Liabilities</strong></td>
                        </tr>

                        <!-- CURRENT LIABILITIES -->
                        <tr>
                        <td colspan="2"><strong>Current Liabilities</strong></td>
                        </tr>

                        <t t-foreach="data.get('liabilities', {}).get('current', [])" t-as="line">
                        <tr>
                            <td><t t-esc="line['account']"/></td>
                            <td class="text-end">
                            <t t-esc="line['balance']"
                                t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                            </td>
                        </tr>
                        </t>

                        <!-- NON-CURRENT LIABILITIES -->
                        <tr>
                        <td colspan="2"><strong>Non-Current Liabilities</strong></td>
                        </tr>

                        <t t-foreach="data.get('liabilities', {}).get('non_current', [])" t-as="line">
                        <tr>
                            <td><t t-esc="line['account']"/></td>
                            <td class="text-end">
                            <t t-esc="line['balance']"
                                t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                            </td>
                        </tr>
                        </t>

                        <tr class="table-light">
                        <td><strong>Total Liabilities</strong></td>
                        <td class="text-end">
                            <strong>
                            <t t-esc="data['liabilities']['total']"
                                t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                            </strong>
                        </td>
                        </tr>

                        <!-- EQUITY HEADER -->
                        <tr class="table-secondary">
                        <td colspan="2"><strong>Equity</strong></td>
                        </tr>

                        <t t-foreach="data.get('equity', {}).get('lines', [])" t-as="line">
                        <tr>
                            <td><t t-esc="line['account']"/></td>
                            <td class="text-end">
                            <t t-esc="line['balance']"
                                t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                            </td>
                        </tr>
                        </t>

                        <tr class="table-light">
                        <td><strong>Total Equity</strong></td>
                        <td class="text-end">
                            <strong>
                            <t t-esc="data['equity']['total']"
                                t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                            </strong>
                        </td>
                        </tr>

                        <!-- BALANCING CHECK -->
                        <tr class="table-dark">
                        <td><strong>Total Liabilities + Equity</strong></td>
                        <td class="text-end">
                            <strong>
                            <t t-esc="data['liabilities']['total'] + data['equity']['total']"
                                t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                            </strong>
                        </td>
                        </tr>


                    </tbody>
                    </table>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>